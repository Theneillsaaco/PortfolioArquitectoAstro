---
import { Icon } from '@twodft/astro-icon/components';
import Heading from '../ui/Heading.astro';

const programas = [
    { name: 'Anteproyecto', href: '#' },
    { name: 'Proyecto Ejecutivo', href: '#' },
    { name: 'Dirección de Obra', href: '#' },
    { name: 'Gerenciamiento', href: '#' },
];

const contacto = [
    { text: 'Bávaro, Punta Cana, RD', icon: 'material-symbols:location-on', href: null },
    { text: '+1 829 983 2226', icon: 'material-symbols:phone-enabled', href: 'tel:+18299832226' },
    { text: 'andryssantana2@gmail.com', icon: 'material-symbols:stacked-email', href: 'mailto:andryssantana2@gmail.com' },
];

const social = [
    {
        name: 'WhatsApp',
        href: 'https://wa.me/18299832226',
        icon: 'mdi:whatsapp',
        hoverClass: 'hover:bg-green-50 hover:border-green-300 hover:text-green-700' 
    },
];

const year = new Date().getFullYear();
---

<footer class="bg-cream-100 border-t border-cream-200 pt-12 pb-6">
    <div class="container mx-auto px-6">
    
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
    
        <!-- Brand -->
        <div class="sm:col-span-2 lg:col-span-1">
            <div class="flex items-center gap-2 mb-4">
                <div class="w-8 h-8 rounded-xl bg-primary-100 flex items-center justify-center text-primary-700 shrink-0">
                    <Icon name="logo" class="w-4 h-4" aria-hidden="true" />
                </div>
                
                <span class="text-sm font-medium text-cream-900">Arquitecto</span>
            </div>
            
            <p class="text-xs text-cream-700 leading-relaxed max-w-xs">
                Diseñamos espacios únicos que reflejan las necesidades y deseos
                de quienes los habitarán, con pasión por cada detalle.
            </p>
        </div>
    
        <!-- Programas -->
        <div>
            <p class="text-xs font-medium text-cream-600 uppercase tracking-widest mb-3">
                Programas
            </p>
            
            <ul class="flex flex-col gap-1">
                {programas.map(item => (
                    <li>
                        <a
                            href={item.href}
                            class="flex items-center gap-2 px-3 py-2 rounded-xl text-sm text-cream-800 hover:bg-cream-200 hover:text-primary-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500"
                        >
                            <Icon
                                name="material-symbols:keyboard-arrow-right"
                                class="w-3.5 h-3.5 text-accent-600 shrink-0"
                                aria-hidden="true"
                            />
                            
                            {item.name}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    
        <!-- Contacto -->
        <div>
            <p class="text-xs font-medium text-cream-600 uppercase tracking-widest mb-3">
                Contacto
            </p>
            <ul class="flex flex-col gap-1">
                {contacto.map(item => {
                    const Tag = item.href ? 'a' : 'div';
                    return (
                        <Tag
                            href={item.href ?? undefined}
                            class:list={[
                                "flex items-center gap-3 px-3 py-2 rounded-xl",
                                "text-sm text-cream-700 transition-colors duration-200",
                                item.href
                                    ? "hover:bg-cream-200 hover:text-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                    : "cursor-default",
                            ]}
                        >
                            <div class="w-7 h-7 rounded-lg bg-cream-200 flex items-center justify-center text-primary-700 shrink-0">
                                <Icon name={item.icon} class="w-3.5 h-3.5" aria-hidden="true" />
                            </div>
                            
                            {item.text}
                        </Tag>
                    );
                })}
            </ul>
        </div>
    
        <!-- Social -->
        <div>
            <p class="text-xs font-medium text-cream-600 uppercase tracking-widest mb-3">
                Síguenos
            </p>
            <div class="flex flex-wrap gap-2">
                {social.map(soc => (
                    <a
                        href={soc.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={soc.name}
                        class:list={[
                            "w-9 h-9 flex items-center justify-center rounded-xl",
                            "bg-cream-50 border border-cream-200 text-cream-700",
                            "transition-colors duration-200",
                            "focus:outline-none focus:ring-2 focus:ring-primary-500",
                            soc.hoverClass,
                        ]}
                    >
                        <Icon name={soc.icon} class="w-4 h-4" aria-hidden="true" />
                    </a>
                ))}
            </div>
        </div>
    
        </div>
    
        <!-- Bottom bar -->
        <div class="border-t border-cream-200 pt-5 flex flex-col sm:flex-row items-center justify-between gap-3">
            <p class="text-xs text-cream-600">
                © {year} Estudio de Arquitectura.
            </p>
            <p class="flex items-center gap-1.5 text-xs text-cream-600">
                Desarrollado con
                <Icon name="material-symbols:favorite" class="w-3.5 h-3.5 text-red-400" aria-hidden="true" />
                y
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-cream-200 text-cream-800 text-xs font-medium">
                    <Icon name="material-symbols:rocket-launch" class="w-3 h-3" aria-hidden="true" />
                    Astro
                </span>
            </p>
        </div>
    </div>
</footer>