---
import { Icon } from "@twodft/astro-icon/components";

type ButtonVariant = "filled" | "tonal" | "outline";

export interface Props {
    link?: string;
    text: string;
    iconName?: string;
    iconAfterText?: boolean;
    variant?: ButtonVariant;
    ariaLabel?: string;
    disabled?: boolean;
    isLoading?: boolean;
    isExternal?: boolean;
    isActive?: boolean;
    class?: string;
    scrollTarget?: string;
    onClick?: string;
    animatedBorder?: boolean;
    [key: string]: unknown; // permite data-* y otros atributos extra
}

const {
    link,
    text,
    iconName,
    iconAfterText = false,
    variant = "filled",
    ariaLabel,
    disabled = false,
    isLoading = false,
    isExternal = false,
    isActive = false,
    class: cls = "",
    scrollTarget,
    onClick,
    animatedBorder = false,
    ...rest
} = Astro.props as Props;

/* ── Variantes MD3 ── */
const base = [
    "relative inline-flex items-center justify-center gap-2",
    "rounded-full text-sm font-medium px-5 py-2.5",
    "transition-colors duration-200 ease-in-out",
    "cursor-pointer select-none",
    "disabled:opacity-40 disabled:cursor-not-allowed",
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2",
    cls,
].join(" ");

const variants: Record<ButtonVariant, string> = {
    filled:  "bg-primary-500 text-white hover:bg-primary-600 focus-visible:ring-primary-500",
    tonal:   "bg-primary-100 text-primary-800 hover:bg-primary-200 focus-visible:ring-primary-400",
    outline: [
        "border border-primary-400 text-primary-700",
        "focus-visible:ring-primary-400",
        // Con animatedBorder: fondo sólido para tapar el conic interior
        // Sin animatedBorder: semitransparente con blur para fondos
        animatedBorder
            ? "bg-cream-50 hover:bg-primary-100"
            : "bg-cream-50/70 hover:bg-cream-50/90 backdrop-blur-sm",
    ].join(" "),
};

/* ── Animated border wrapper ── */
const wrappers: Record<ButtonVariant, string> = {
    filled:  "p-px rounded-full bg-conic-primary  animate-rotate-border w-fit h-fit",
    tonal:   "p-px rounded-full bg-conic-secondary animate-rotate-border w-fit h-fit",
    outline: "p-px rounded-full bg-conic-outline   animate-rotate-border w-fit h-fit backdrop-blur-sm",
};

const btnClass = `${base} ${variants[variant]}`;
const isExtLink = isExternal || (link?.startsWith("http") ?? false);
const useButton = !link || !!scrollTarget || !!onClick;
const onClickFn = onClick ?? (scrollTarget ? `scrollToSection('${scrollTarget}')` : undefined);
const label = ariaLabel ?? text;
const displayText = isLoading ? "Cargando…" : text;
---

<!--
  Un único slot de contenido — sin duplicar el bloque ícono+texto 4 veces.
  El Astro component wrapper decide si envolver con el anillo animado.
-->

{(() => {
    const inner = (
        <>
            {!iconAfterText && iconName && (
                <Icon name={iconName} class="w-4 h-4 shrink-0" aria-hidden="true" />
            )}
            
            {isLoading && (
                <Icon name="material-symbols:progress-activity" class="w-4 h-4 shrink-0 animate-spin" aria-hidden="true" />
            )}
            
            <span>
                {displayText}
            </span>
            
            {iconAfterText && iconName && (
                <Icon name={iconName} class="w-4 h-4 shrink-0" aria-hidden="true" />
            )}
        </>
    );

    const sharedProps = {
        "aria-label": label,
        "aria-disabled": disabled,
        "aria-busy": isLoading,
        "aria-pressed": isActive,
        class: btnClass,
        ...rest,
    };

    const element = useButton ? (
        <button
            {...sharedProps}
            disabled={disabled}
            onclick={onClickFn}
        >
            {inner}
        </button>
    ) : (
        <a
            {...sharedProps}
            href={disabled ? "#" : link}
            role="button"
            target={isExtLink ? "_blank" : undefined}
            rel={isExtLink ? "noopener noreferrer" : undefined}
        >
            {inner}
        </a>
    );

    return animatedBorder ? (
        <div class={wrappers[variant]}>{element}</div>
    ) : element;
})()}

<script is:inline>
    window.scrollToSection = (id) => {
        document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
    };
</script>